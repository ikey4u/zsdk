--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-ios-simulator, arm64-ios-simulator ]
install-name:    '/System/Library/Frameworks/ReplayKit.framework/ReplayKit'
exports:
  - targets:         [ x86_64-ios-simulator, arm64-ios-simulator ]
    symbols:         [ _RPApplicationInfoBundleIdentifierKey, _RPLogSetLogLevel, 
                       _RPRecordingErrorDomain, _RPStringUtility_CStrToFourcc, _RPStringUtility_FourccToCStr, 
                       _RPVideoEditorExtensionAppNameKey, _RPVideoEditorExtensionBundleIdentifierKey, 
                       _RPVideoEditorExtensionFileAttachmentKey, _RPVideoEditorExtensionMoviePathKey, 
                       _RPVideoEditorExtensionOverrideShareMessageKey, _RPVideoEditorExtensionOverrideTintColorKey, 
                       _RPVideoSampleOrientationKey, _ReplayKitVersionNumber, _ReplayKitVersionString, 
                       _SCContentFilterCreateCurrentApplicationFilterDictionary, 
                       _SCContentFilterCreateiOSDisplayFilterDictionary, _SCStreamErrorDomain, 
                       ___RPLogLevel, _showReactionsTip ]
    objc-classes:    [ RPAudioMixUtility, RPBackgroundActivity, RPBroadcastActivityExtensionHostContext, 
                       RPBroadcastActivityHostViewController, RPBroadcastActivityViewController, 
                       RPBroadcastConfiguration, RPBroadcastController, RPBroadcastExtensionHostContext, 
                       RPBroadcastHandler, RPBroadcastHostViewController, RPBroadcastMP4ClipHandler, 
                       RPBroadcastSampleHandler, RPControlCenterAngelProxy, RPControlCenterClient, 
                       RPDaemonProxy, RPExtensionContext, RPExtensionHostContext, 
                       RPFeatureFlagUtility, RPFlatVideoOverlayButton, RPHighFidelityVideoOverlayButton, 
                       RPModalPresentationWindow, RPPipView, RPPipViewController, 
                       RPPreviewViewController, RPScreenRecorder, RPStoreInfo, RPStoreManager, 
                       RPStringUtility, RPSystemBroadcastPickerView, RPVideoEditorExtensionHostContext, 
                       RPVideoEditorHostViewController, SCCurrentClientPickerInfo ]
...
