--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-ios-simulator, arm64-ios-simulator ]
install-name:    '/System/Library/Frameworks/AudioToolbox.framework/libEmbeddedSystemAUs.dylib'
exports:
  - targets:         [ x86_64-ios-simulator ]
    weak-symbols:    [ __ZTINSt3__111regex_errorE, __ZTINSt3__112format_errorE, __ZTINSt3__112system_errorE, 
                       __ZTINSt3__117bad_function_callE, __ZTISt11logic_error, __ZTISt12length_error, 
                       __ZTISt12out_of_range, __ZTISt13runtime_error, __ZTISt14overflow_error, 
                       __ZTISt20bad_array_new_length, __ZTISt9bad_alloc, __ZTISt9exception, 
                       __ZTSNSt3__111regex_errorE, __ZTSNSt3__112format_errorE, __ZTSNSt3__112system_errorE, 
                       __ZTSNSt3__117bad_function_callE, __ZTSSt11logic_error, __ZTSSt12length_error, 
                       __ZTSSt12out_of_range, __ZTSSt13runtime_error, __ZTSSt14overflow_error, 
                       __ZTSSt20bad_array_new_length, __ZTSSt9bad_alloc, __ZTSSt9exception ]
  - targets:         [ x86_64-ios-simulator, arm64-ios-simulator ]
    symbols:         [ _AUAsyncRendererFactory, _AUBandpassFactory, _AUConverterFactory, 
                       _AUDeferredRendererFactory, _AUDelayFactory, _AUDistortionFactory, 
                       _AUDynamicsProcessorFactory, _AUFilterFactory, _AUGenericOutputFactory, 
                       _AUHapticSynthFactory, _AUHighShelfFilterFactory, _AUHipassFactory, 
                       _AULopassFactory, _AULowShelfFilterFactory, _AUMatrixMixerFactory, 
                       _AUMatrixReverbLiteFactory, _AUMergerFactory, _AUMultiChannelMixerFactory, 
                       _AUMultiSplitterFactory, _AUNewPitchFactory, _AUNewTimePitchFactory, 
                       _AUNotQuiteSoSimpleTimeFactory, _AUParametricEQFactory, _AUPeakLimiterFactory, 
                       _AUPitchFactory, _AUSampleDelayFactory, _AUSimpleTimeFactory, 
                       _AUSpatializationHostFactory, _AUSpecialPurposeSweepFilterFactory, 
                       _AUSplitterFactory, _AUVarispeedFactory, _AudioOutputUnitPublish_Impl, 
                       _MIDISynthFactory, _RegisterAudioUnits_Instruments, _RegisterAudioUnits_Toolbox, 
                       _SamplerFactory ]
...
