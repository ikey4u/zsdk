--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-ios-simulator, arm64-ios-simulator ]
install-name:    '/System/Library/Frameworks/DeviceCheck.framework/DeviceCheck'
exports:
  - targets:         [ x86_64-ios-simulator, arm64-ios-simulator ]
    symbols:         [ _DCErrorDomain ]
    objc-classes:    [ DCAppAttestDeviceService, DCAppAttestService, DCAppAttestServicePriv, 
                       DCAppAttestWebAuthService, DCDevice ]
...
